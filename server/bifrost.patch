+    private static IBinder aynPanelService;
+
+    private static IBinder getAynPanelService() {
+        if (aynPanelService != null && aynPanelService.isBinderAlive()) {
+            return aynPanelService;
+        }
+        try {
+            Class<?> serviceManager = Class.forName("android.os.ServiceManager");
+            aynPanelService = (IBinder) serviceManager.getMethod("getService", String.class).invoke(null, "PServerBinder");
+        } catch (Exception e) {
+            aynPanelService = null;
+        }
+        return aynPanelService;
+    }
+
+    private static boolean runAynCommand(IBinder service, String command) {
+        android.os.Parcel data = android.os.Parcel.obtain();
+        android.os.Parcel reply = android.os.Parcel.obtain();
+        try {
+            data.writeStringArray(new String[] {command, "0"});
+            return service.transact(0, data, reply, 0);
+        } catch (Exception e) {
+            Ln.w("AYN panel command failed: " + e);
+            return false;
+        } finally {
+            data.recycle();
+            reply.recycle();
+        }
+    }
+
+    public static boolean setAynPanels(boolean on) {
+        IBinder service = getAynPanelService();
+        if (service == null) {
+            return false;
+        }
+        String value = on ? "0" : "1";
+        boolean ok = runAynCommand(service, "echo " + value + " > sys/class/backlight/panel0-backlight/bl_power");
+        ok &= runAynCommand(service, "echo " + value + " > sys/class/backlight/panel1-backlight/bl_power");
+        return ok;
+    }
+
+    private static java.util.concurrent.ScheduledExecutorService aynKeeper;
+    private static java.util.concurrent.ScheduledFuture<?> aynKeepOff;
+
+    private static synchronized void keepAynPanelsOff(boolean keep) {
+        if (aynKeepOff != null) {
+            aynKeepOff.cancel(false);
+            aynKeepOff = null;
+        }
+        if (!keep) {
+            return;
+        }
+        if (aynKeeper == null) {
+            aynKeeper = java.util.concurrent.Executors.newSingleThreadScheduledExecutor(r -> {
+                Thread thread = new Thread(r, "ayn-panels");
+                thread.setDaemon(true);
+                return thread;
+            });
+        }
+        aynKeepOff = aynKeeper.scheduleWithFixedDelay(() -> setAynPanels(false), 1500, 1500, java.util.concurrent.TimeUnit.MILLISECONDS);
+    }
+
     public static boolean setDisplayPower(int displayId, boolean on) {
         assert displayId != Device.DISPLAY_ID_NONE;
 
+        if (setAynPanels(on)) {
+            keepAynPanelsOff(!on);
+            return true;
+        }
+
         if (USE_ANDROID_15_DISPLAY_POWER && Build.VERSION.SDK_INT >= AndroidVersions.API_35_ANDROID_15) {
             return ServiceManager.getDisplayManager().requestDisplayPower(displayId, on);
         }
